{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "target": "ES2017",
    // "module": "ESNext", // es2022, esnext, system, node16, nodenext, preserve, commonjs
    "module": "system",
    "outFile": "dist/bundle.js",
    "declaration": false,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}