{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "target": "ES2017",
    "module": "commonjs", // es2022, esnext, system, node16, nodenext, preserve, commonjs
    "declaration": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": [
    "node_modules",
  ]
}